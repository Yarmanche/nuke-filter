# Copy this file to .env (next to the scripts) and fill in what you need.
# Every value can also be set as a plain environment variable instead.

# Telegram bot token (required only for nuke_bot.py / the tray bot toggle).
# Legacy name NUKE_BOT_TOKEN is also accepted.
FILTER_BOT_TOKEN=

# Text rendered inside the box logo (run.py regenerates the logo from this).
FILTER_TEXT=YOUR BRAND

# Box color, "R,G,B".
FILTER_COLOR=196,30,30

# Display name shown by the Telegram bot and tray icon.
FILTER_APP_NAME=Boxed Filter

# Logo width as a fraction of the image width (default 0.55).
FILTER_LOGO_WIDTH=0.55

# Web server port (nuke_server.py / nuke_tray.py).
FILTER_PORT=8788

# Explicit path to a bold .ttf font; leave empty to auto-detect.
FILTER_FONT=

# Custom logo PNG; defaults to assets/nuke_logo.png in this folder.
#FILTER_LOGO=/path/to/logo.png

# Where processed photos land (run.py); defaults to ./out next to the scripts.
#FILTER_OUT_DIR=/path/to/out
